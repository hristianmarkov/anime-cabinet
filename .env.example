# === Anime Cabinet environment variables ===
# Copy to .env.local for local dev; set the same in Vercel Project Settings.

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://animecabinet.com

# Google Analytics 4 (analytics.google.com -> Admin -> Data streams)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-WJCQYPH25T

# Neon Postgres (Vercel Marketplace -> Neon, or neon.tech dashboard)
DATABASE_URL=

# Stripe (dashboard.stripe.com -> Developers -> API keys)
STRIPE_SECRET_KEY=
# Webhook signing secret for the endpoint /api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# Vercel Blob (created automatically when you add Blob storage to the project)
BLOB_READ_WRITE_TOKEN=

# Resend (resend.com -> API keys) for order emails
RESEND_API_KEY=
# Verified sender, e.g. "Anime Cabinet <orders@animecabinet.com>"
EMAIL_FROM=
# Where new-order alerts are sent
ADMIN_EMAIL=

# Password for the /admin dashboard
ADMIN_PASSWORD=

# Gelato print-on-demand (dashboard.gelato.com -> API keys)
GELATO_API_KEY=
# Product UIDs from Gelato catalogue — map to our print formats
GELATO_UID_POSTER_12X18=
GELATO_UID_POSTER_18X24=
GELATO_UID_CANVAS_12X18=
GELATO_UID_CANVAS_18X24=
GELATO_UID_FRAMED_12X18=
GELATO_UID_FRAMED_18X24=
# Multiplier applied to Gelato wholesale print cost for customer add-on pricing (default 2)
GELATO_PRINT_MARKUP=2
